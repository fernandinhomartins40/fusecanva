# =============================================================================
# Fuse Studio - variaveis de ambiente (desenvolvimento local)
# =============================================================================
# Copie para `.env` na raiz:   cp .env.example .env
# O `.env` nunca e versionado (ver .gitignore). Todos os valores abaixo sao padroes de
# DESENVOLVIMENTO; troque senhas e chaves antes de expor qualquer servico fora da sua maquina.
#
# Quem le este arquivo:
#   - docker compose (interpolacao):  docker compose -f infra/docker/docker-compose.yml --env-file .env ...
#   - node infra/docker/dev-all.mjs:  carrega este .env para o Vite e para a API locais.
#   - `pnpm --filter @fuse/web run dev:api` sozinho le apps/web/.env (nao este arquivo).
#
# Legenda: [atual] = lido pelo codigo de hoje (apps/web/server, vite.config.ts)
#          [v2]    = reservado para os modulos da v2 (Postgres, S3, filas, SMTP); hoje so e
#                    repassado aos containers e ainda nao tem efeito no servidor.

# -----------------------------------------------------------------------------
# API / aplicacao
# -----------------------------------------------------------------------------
# [atual] Porta HTTP da API (servidor em apps/web/server/index.mjs).
PORT=8787
# [atual] Porta para onde o Vite encaminha /api em desenvolvimento (deve bater com PORT).
STUDIO_API_PORT=8787
# [atual] Host de bind da API. O servidor atual fixa 127.0.0.1; no container o entrypoint
# infra/docker/api-entrypoint.mjs usa este valor para escutar em 0.0.0.0.
# STUDIO_API_HOST=0.0.0.0
# [atual] Origens aceitas pela API (CORS / verificacao de Origin), separadas por virgula.
APP_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:8080,http://localhost:8080
# [atual] "production" ativa cookies Secure. Deixe vazio em desenvolvimento local fora do Docker.
# NODE_ENV=development

# [atual] Banco SQLite e diretorio de midia enderecada por conteudo (padroes mostrados,
# relativos ao diretorio de execucao da API). No container: /data/studio.sqlite e /data/media.
# STUDIO_DB_PATH=.data/studio.sqlite
# STUDIO_MEDIA_OBJECT_DIR=.data/media

# [atual] URL publica do app, usada em links de convite e recuperacao de senha.
STUDIO_PUBLIC_APP_URL=http://localhost:5173

# -----------------------------------------------------------------------------
# IA (traga a sua chave ou use um modelo local; a chave fica so no servidor)
# -----------------------------------------------------------------------------
# [atual] Texto: "disabled", "sandbox" (texto deterministico de demonstracao) ou
# "openai-compatible" (qualquer provedor com API compativel, inclusive Ollama/LM Studio local,
# p.ex. STUDIO_AI_BASE_URL=http://127.0.0.1:11434/v1).
STUDIO_AI_MODE=disabled
STUDIO_AI_BASE_URL=https://api.openai.com/v1
STUDIO_AI_API_KEY=
STUDIO_AI_MODEL=
# [atual] Imagem: "sandbox" (local, deterministico) ou um provedor compativel com a API de
# imagens no estilo OpenAI (defina modo, URL base, chave e modelo).
STUDIO_IMAGE_AI_MODE=sandbox
STUDIO_IMAGE_AI_BASE_URL=https://api.openai.com/v1
STUDIO_IMAGE_AI_API_KEY=
STUDIO_IMAGE_AI_MODEL=

# -----------------------------------------------------------------------------
# E-mail transacional
# -----------------------------------------------------------------------------
# [atual] Entrega de convites e recuperacao de senha. Sem provedor, o app gera so o link
# (nada sai da maquina). Hoje o unico provedor suportado e "resend".
# STUDIO_EMAIL_PROVIDER=resend
# STUDIO_EMAIL_API_KEY=
# STUDIO_EMAIL_FROM=
# [v2] SMTP generico. Em dev aponta para o Mailpit (UI em http://127.0.0.1:8025).
SMTP_URL=smtp://127.0.0.1:1025
SMTP_FROM="Fuse Studio <no-reply@fuse.localhost>"

# -----------------------------------------------------------------------------
# Integracoes externas opcionais (deixe vazias para manter desativadas)
# -----------------------------------------------------------------------------
# [atual] Endpoints precisam usar HTTPS e resolver apenas para enderecos publicos.
# Credenciais ficam no servidor; nunca copie para variaveis VITE_* nem para o navegador.
# SITE_PUBLISHER_URL=
# SITE_PUBLISHER_TOKEN=
# PRINT_CHECKOUT_URL=
# PRINT_CHECKOUT_TOKEN=

# -----------------------------------------------------------------------------
# Postgres  [v2 - ADR-008]
# -----------------------------------------------------------------------------
POSTGRES_USER=fuse
POSTGRES_PASSWORD=fuse-dev-password
POSTGRES_DB=fuse
POSTGRES_HOST_PORT=5432
# URL usada pela API rodando no host. Dentro do compose a API usa o host "postgres".
DATABASE_URL=postgres://fuse:fuse-dev-password@127.0.0.1:5432/fuse

# -----------------------------------------------------------------------------
# Armazenamento S3-compativel / MinIO  [v2 - ADR-009]
# -----------------------------------------------------------------------------
# As mesmas credenciais viram o usuario raiz do MinIO em dev.
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=fuse-media
S3_ACCESS_KEY_ID=fuse-dev
S3_SECRET_ACCESS_KEY=fuse-dev-secret
# MinIO exige path-style (http://host/bucket/chave).
S3_FORCE_PATH_STYLE=true
MINIO_API_HOST_PORT=9000
# Console web do MinIO: http://127.0.0.1:9001
MINIO_CONSOLE_HOST_PORT=9001

# -----------------------------------------------------------------------------
# Redis / filas BullMQ  [v2 - ADR-010]
# -----------------------------------------------------------------------------
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_HOST_PORT=6379

# -----------------------------------------------------------------------------
# Mailpit (captura de e-mail em dev)
# -----------------------------------------------------------------------------
MAILPIT_SMTP_HOST_PORT=1025
MAILPIT_UI_HOST_PORT=8025

# -----------------------------------------------------------------------------
# Aplicacao conteinerizada (perfil "app" do compose)
# -----------------------------------------------------------------------------
API_HOST_PORT=8787
WEB_HOST_PORT=8080

# -----------------------------------------------------------------------------
# Imagens Docker (opcional: troque por espelhos ou versoes fixadas)
# -----------------------------------------------------------------------------
# POSTGRES_IMAGE=postgres:17-alpine
# MINIO_IMAGE=minio/minio:RELEASE.2025-04-22T22-12-26Z
# MINIO_MC_IMAGE=minio/mc:RELEASE.2025-04-16T18-13-26Z
# REDIS_IMAGE=redis:8.2-alpine
# MAILPIT_IMAGE=axllent/mailpit:v1.27
