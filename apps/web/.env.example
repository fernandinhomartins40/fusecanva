# Persistent server database and content-addressed upload directory (defaults shown).
# STUDIO_DB_PATH=.data/studio.sqlite
# STUDIO_MEDIA_OBJECT_DIR=.data/media
# Set mode to "sandbox" for deterministic demo text, or "openai-compatible" for a configured provider.
STUDIO_AI_MODE=disabled
STUDIO_AI_BASE_URL=https://api.openai.com/v1
STUDIO_AI_API_KEY=
STUDIO_AI_MODEL=
# Image generation: sandbox is local/deterministic. For an OpenAI Images API compatible
# provider, set mode, base URL, key, and model. Keep the API key server-side.
STUDIO_IMAGE_AI_MODE=sandbox
STUDIO_IMAGE_AI_BASE_URL=https://api.openai.com/v1
STUDIO_IMAGE_AI_API_KEY=
STUDIO_IMAGE_AI_MODEL=

# Optional invitation and password-recovery email delivery. Leave unset to prevent external email.
# STUDIO_EMAIL_PROVIDER=resend
# STUDIO_EMAIL_API_KEY=
# STUDIO_EMAIL_FROM=
# STUDIO_PUBLIC_APP_URL=

# Optional external service contracts. Keep these unset to leave both integrations disabled.
# Endpoints must use HTTPS and resolve only to public addresses. Credentials stay in this
# server-side environment; never copy them to VITE_* variables or browser storage.
# SITE_PUBLISHER_URL=
# SITE_PUBLISHER_TOKEN=
# PRINT_CHECKOUT_URL=
# PRINT_CHECKOUT_TOKEN=
